# ── App ────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"

# ── Database (Neon) ────────────────────────────────────────────────
# Neon dashboard → Connect. DATABASE_URL is the pooled string (host has "-pooler"),
# DATABASE_URL is the direct one. Migrations use DATABASE_URL, the app uses DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/loopify?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/loopify?sslmode=require"

# ── Auth (NextAuth) ────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# ── Email (Nodemailer over Gmail SMTP) ─────────────────────────────
# EMAIL_PASS must be a Google App Password (Google Account → Security → 2-Step Verification → App passwords).
# Leave both empty in development and codes are printed in the terminal instead.
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="465"
EMAIL_FROM_NAME="Loopify"

# ── AI (Grok via the OpenAI-compatible adapter) ────────────────────
# AI_PROVIDER: XAI or OPENAI_COMPATIBLE (then set AI_BASE_URL).
# Without AI_API_KEY, capture falls back to a simple rule-based extractor.
AI_PROVIDER="XAI"
AI_API_KEY=""
AI_MODEL="grok-4"
AI_BASE_URL="https://api.x.ai/v1"

# ── Google (Sheets chat) ───────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"
# Encrypts OAuth tokens at rest. 32 bytes, base64. Same command as AUTH_SECRET.
TOKEN_ENCRYPTION_KEY=""

# ── Background jobs (Inngest) ──────────────────────────────────────
# Not needed locally (run `npm run inngest:dev`, or jobs run inline when it isn't running).
# In production, copy these from the Inngest dashboard.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ── Platform admin ─────────────────────────────────────────────────
# Comma-separated emails that can always open /admin. Grant more admins from the console itself.
PLATFORM_ADMIN_EMAILS=""
