# Where the Loopify web app lives. Local dev from Docker Desktop: http://host.docker.internal:3000
LOOPIFY_URL=https://loopify.example.com
# Same value as RUNNER_SECRET in the web app. Generate: openssl rand -hex 32
RUNNER_SECRET=
XAI_API_KEY=

# Optional
BOT_NAME=Loopify Notetaker
RUNNER_ID=office-pc
MAX_CONCURRENT=2
POLL_SECONDS=20
ADMIT_TIMEOUT_MIN=10
ALONE_TIMEOUT_MIN=3
MAX_MEETING_MIN=180
KEEP_AUDIO=false
# Leave empty for xAI's default transcription model
XAI_STT_MODEL=
