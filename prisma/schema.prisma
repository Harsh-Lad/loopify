// Loopify data model.
// Every tenant-owned table carries orgId so the platform stays multi-tenant.
// CardEvent is an append-only log: history, daily recaps, rollover and reports are derived from it.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Identity and auth
// ─────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String
  emailVerified   DateTime?
  image           String?
  timezone        String    @default("Asia/Kolkata")
  activeOrgId     String?
  /// Platform staff: can open /admin and manage every org and user.
  isPlatformAdmin Boolean   @default(false)
  /// Suspended users can't sign in or call the API.
  suspendedAt     DateTime?
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships     OrgMember[]
  teamMemberships TeamMember[]
  assignedCards   Card[]         @relation("CardAssignee")
  reportedCards   Card[]         @relation("CardReporter")
  comments        CardComment[]
  events          CardEvent[]
  dayPlans        DayPlan[]
  captures        Capture[]
  integrations    Integration[]
  chatSessions    ChatSession[]
  notifications   Notification[]
  invitesSent     OrgInvite[]
  personalBoards  Board[]        @relation("PersonalBoard")
  cardMirrors     CardMirror[]
}

enum VerificationPurpose {
  SIGN_UP
  PASSWORD_RESET
}

/// One-time codes for email verification and account recovery. Codes are stored hashed.
model VerificationCode {
  id         String              @id @default(cuid())
  email      String
  purpose    VerificationPurpose
  codeHash   String
  attempts   Int                 @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  @@index([email, purpose])
}

/// Fixed-window rate limiting without Redis.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// Organizations and teams
// ─────────────────────────────────────────────────────────────

enum OrgRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

enum TeamRole {
  LEAD
  MEMBER
}

model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  /// Suspended orgs are read-blocked for every member until a platform admin restores them.
  suspendedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members       OrgMember[]
  invites       OrgInvite[]
  teams         Team[]
  boards        Board[]
  templates     WorkflowTemplate[]
  cards         Card[]
  events        CardEvent[]
  dayPlans      DayPlan[]
  captures      Capture[]
  integrations  Integration[]
  chatSessions  ChatSession[]
  notifications Notification[]
  aiConfig      AiProviderConfig?
}

model OrgMember {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  role       OrgRole  @default(MEMBER)
  title      String?
  /// Put every team card assigned to me on my personal board automatically, as a mirror.
  autoMirror Boolean  @default(false)
  createdAt  DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model OrgInvite {
  id          String    @id @default(cuid())
  orgId       String
  email       String
  role        OrgRole   @default(MEMBER)
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy User         @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([orgId, email])
}

model Team {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  slug        String
  description String?
  icon        String   @default("users")
  color       String   @default("violet")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members TeamMember[]
  boards  Board[]

  @@unique([orgId, slug])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Workflows: templates are blueprints, boards own their copy
// ─────────────────────────────────────────────────────────────

enum TemplateCategory {
  GENERAL
  TECH
  CREATIVE
  SALES
  INFLUENCER
  OUTREACH
}

enum StatusCategory {
  TODO
  IN_PROGRESS
  DONE
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
  URL
  CHECKBOX
  PERSON
}

/// orgId = null marks a built-in system template.
/// columns: [{ name, color, category, wipLimit? }]
/// fields:  [{ key, label, type, options?, required? }]
model WorkflowTemplate {
  id          String           @id @default(cuid())
  orgId       String?
  name        String
  description String?
  category    TemplateCategory @default(GENERAL)
  icon        String           @default("layout-kanban")
  columns     Json
  fields      Json             @default("[]")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  org    Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  boards Board[]

  @@index([orgId])
}

/// A team board (teamId set) or one person's private board (ownerId set, teamId null).
model Board {
  id         String    @id @default(cuid())
  orgId      String
  teamId     String?
  ownerId    String?
  templateId String?
  name       String
  key        String
  icon       String    @default("layout-kanban")
  cardSeq    Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  org      Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team     Team?             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  owner    User?             @relation("PersonalBoard", fields: [ownerId], references: [id], onDelete: Cascade)
  template WorkflowTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  columns  BoardColumn[]
  fields   FieldDefinition[]
  cards    Card[]
  events   CardEvent[]
  mirrors  CardMirror[]

  @@unique([orgId, key])
  /// One personal board per person per org.
  @@unique([orgId, ownerId])
  @@index([teamId])
}

model BoardColumn {
  id        String         @id @default(cuid())
  boardId   String
  name      String
  color     String         @default("slate")
  category  StatusCategory @default(TODO)
  position  Float
  wipLimit  Int?
  createdAt DateTime       @default(now())

  board   Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards   Card[]
  mirrors CardMirror[]

  @@index([boardId, position])
}

model FieldDefinition {
  id        String    @id @default(cuid())
  boardId   String
  key       String
  label     String
  type      FieldType
  options   Json      @default("[]")
  required  Boolean   @default(false)
  position  Float
  createdAt DateTime  @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, key])
}

// ─────────────────────────────────────────────────────────────
// Cards and the event log
// ─────────────────────────────────────────────────────────────

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CardSource {
  MANUAL
  CAPTURE
  SHEETS
  EMAIL
  MEETING
}

model Card {
  id              String     @id @default(cuid())
  orgId           String
  boardId         String
  columnId        String
  number          Int
  title           String
  description     Json?
  descriptionText String?
  priority        Priority   @default(NONE)
  assigneeId      String?
  reporterId      String
  parentId        String?
  dueDate         DateTime?
  position        Float
  labels          String[]   @default([])
  customFields    Json       @default("{}")
  source          CardSource @default(MANUAL)
  captureId       String?
  rolloverCount   Int        @default(0)
  completedAt     DateTime?
  archivedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  org      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  board    Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column   BoardColumn   @relation(fields: [columnId], references: [id], onDelete: Restrict)
  assignee User?         @relation("CardAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter User          @relation("CardReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  parent   Card?         @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Card[]        @relation("Subtasks")
  capture  Capture?      @relation(fields: [captureId], references: [id], onDelete: SetNull)
  comments CardComment[]
  events   CardEvent[]
  planned  DayPlanItem[]
  mirrors  CardMirror[]

  @@unique([boardId, number])
  @@index([columnId, position])
  @@index([assigneeId])
  @@index([orgId, updatedAt])
}

/**
 * A team card shown live on someone's personal board, in a column of their choosing.
 * Not a copy: title, due date and status always come from the source card.
 */
model CardMirror {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  cardId    String
  boardId   String
  columnId  String
  position  Float
  createdAt DateTime @default(now())

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  card   Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  board  Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column BoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([columnId, position])
}

model CardComment {
  id        String   @id @default(cuid())
  cardId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card   Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
}

enum CardEventType {
  CREATED
  UPDATED
  MOVED
  ASSIGNED
  COMMENTED
  COMPLETED
  REOPENED
  PLANNED
  UNPLANNED
  ROLLED_OVER
  ARCHIVED
  RESTORED
}

/// Append-only. Never updated, never deleted except with the card.
model CardEvent {
  id           String        @id @default(cuid())
  orgId        String
  boardId      String
  cardId       String
  actorId      String
  type         CardEventType
  fromColumnId String?
  toColumnId   String?
  payload      Json          @default("{}")
  createdAt    DateTime      @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  board Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  card  Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  actor User         @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
  @@index([actorId, createdAt])
  @@index([orgId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// The daily loop: plan, diary, rollover, summary
// ─────────────────────────────────────────────────────────────

enum DayItemStatus {
  PLANNED
  DONE
  ROLLED
  DROPPED
}

/// One per user, per org, per local calendar day. The diary page plus the day's plan.
model DayPlan {
  id                 String    @id @default(cuid())
  orgId              String
  userId             String
  date               DateTime  @db.Date
  note               Json?
  noteText           String?
  mood               String?
  summary            String?
  summaryGeneratedAt DateTime?
  closedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  org   Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items DayPlanItem[]

  @@unique([orgId, userId, date])
}

model DayPlanItem {
  id           String        @id @default(cuid())
  dayPlanId    String
  cardId       String
  position     Float
  status       DayItemStatus @default(PLANNED)
  rolledFromId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  dayPlan    DayPlan       @relation(fields: [dayPlanId], references: [id], onDelete: Cascade)
  card       Card          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  rolledFrom DayPlanItem?  @relation("Rollover", fields: [rolledFromId], references: [id], onDelete: SetNull)
  rolledTo   DayPlanItem[] @relation("Rollover")

  @@unique([dayPlanId, cardId])
}

// ─────────────────────────────────────────────────────────────
// Capture: everyday conversations into suggested cards
// ─────────────────────────────────────────────────────────────

enum CaptureSource {
  TEXT
  VOICE
  MEETING
  EMAIL
  MOBILE
}

enum CaptureStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

model Capture {
  id          String        @id @default(cuid())
  orgId       String
  userId      String
  source      CaptureSource @default(TEXT)
  title       String?
  rawText     String
  audioUrl    String?
  status      CaptureStatus @default(PENDING)
  error       String?
  processedAt DateTime?
  createdAt   DateTime      @default(now())

  org         Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestions SuggestedCard[]
  cards       Card[]

  @@index([userId, createdAt])
}

model SuggestedCard {
  id               String           @id @default(cuid())
  captureId        String
  title            String
  description      String?
  assigneeHint     String?
  suggestedUserId  String?
  suggestedBoardId String?
  dueDate          DateTime?
  priority         Priority         @default(NONE)
  confidence       Float            @default(0.5)
  status           SuggestionStatus @default(PENDING)
  cardId           String?
  createdAt        DateTime         @default(now())

  capture Capture @relation(fields: [captureId], references: [id], onDelete: Cascade)

  @@index([captureId])
}

// ─────────────────────────────────────────────────────────────
// Connectors, chat, AI configuration
// ─────────────────────────────────────────────────────────────

enum IntegrationProvider {
  GOOGLE
}

/// Tokens are encrypted at rest with TOKEN_ENCRYPTION_KEY (AES-256-GCM).
model Integration {
  id              String              @id @default(cuid())
  orgId           String
  userId          String
  provider        IntegrationProvider
  accountEmail    String?
  accessTokenEnc  String
  refreshTokenEnc String?
  expiresAt       DateTime?
  scopes          String[]            @default([])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId, provider])
}

enum ChatKind {
  SHEETS
}

enum ChatRole {
  USER
  ASSISTANT
  TOOL
}

model ChatSession {
  id               String   @id @default(cuid())
  orgId            String
  userId           String
  kind             ChatKind @default(SHEETS)
  title            String   @default("New chat")
  spreadsheetId    String?
  spreadsheetTitle String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  org        Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   ChatMessage[]
  operations SheetOperation[]

  @@index([userId, updatedAt])
  @@index([userId, spreadsheetId])
}

model ChatMessage {
  id         String   @id @default(cuid())
  sessionId  String
  role       ChatRole
  content    String
  toolCalls  Json?
  toolCallId String?
  createdAt  DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

enum SheetOperationKind {
  UPDATE
  APPEND
  CLEAR
  CREATE_SPREADSHEET
  ADD_SHEET
}

enum SheetOperationStatus {
  PROPOSED
  APPLIED
  REJECTED
  UNDONE
  FAILED
}

/// Every write proposed by the Sheets chat is previewed here first, then applied, and can be undone.
model SheetOperation {
  id            String               @id @default(cuid())
  sessionId     String
  userId        String
  spreadsheetId String?
  range         String?
  kind          SheetOperationKind
  summary       String
  before        Json?
  after         Json
  result        Json?
  status        SheetOperationStatus @default(PROPOSED)
  error         String?
  appliedAt     DateTime?
  createdAt     DateTime             @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  orgId     String
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

enum AiProvider {
  XAI
  OPENAI_COMPATIBLE
}

/// Per-org override of the default model. apiKeyEnc null means the server env key is used.
model AiProviderConfig {
  id        String     @id @default(cuid())
  orgId     String     @unique
  provider  AiProvider @default(XAI)
  model     String
  baseUrl   String?
  apiKeyEnc String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}
